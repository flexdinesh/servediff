#!/usr/bin/env bash
#MISE description="Open or update the Homebrew tap pull request"

set -euo pipefail

version="${RELEASE_VERSION:?RELEASE_VERSION is required}"
tag="${RELEASE_TAG:?RELEASE_TAG is required}"
branch="servediff-v${version}"
tap_repo="flexdinesh/homebrew-tap"

cd homebrew-tap
git config user.name "github-actions[bot]"
git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
git checkout -B "$branch"

if [[ -z "$(git status --porcelain -- Formula/servediff.rb)" ]]; then
  echo "Homebrew formula is already current for servediff v${version}."
  exit 0
fi

git add Formula/servediff.rb
git commit -m "Update servediff to v${version}"
git push --force-with-lease origin "HEAD:${branch}"

pr_number="$(gh pr list \
  --repo "$tap_repo" \
  --head "$branch" \
  --state open \
  --json number \
  --jq '.[0].number // ""')"

pr_body="$(mktemp)"
cat > "$pr_body" <<EOF
Updates the servediff formula to v${version}.

Source release: https://github.com/flexdinesh/servediff/releases/tag/${tag}

Generated by the servediff release workflow.
EOF

if [[ -n "$pr_number" ]]; then
  gh pr edit "$pr_number" \
    --repo "$tap_repo" \
    --title "Update servediff to v${version}" \
    --body-file "$pr_body"
else
  gh pr create \
    --repo "$tap_repo" \
    --head "$branch" \
    --base main \
    --title "Update servediff to v${version}" \
    --body-file "$pr_body"
fi
