{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["node", "webmcp-types"],
    "paths": {
      "@/*": ["./src/*", "./src/*.ts", "./src/*.tsx"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "test/**/*.ts",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}
